{
  "name": "ipnet-security-website",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/check-assets.mjs && next build",
    "typecheck": "tsc --noEmit",
    "start": "python3 -m http.server 3000 --bind 0.0.0.0 --directory out",
    "preview:build": "node scripts/build-preview.mjs",
    "assets:render": "blender --background --python scripts/build-scene.py -- --all",
    "assets:prepare": "python3 scripts/prepare-frames.py --require-complete"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "gsap": "3.15.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.11",
    "typescript": "7.0.2"
  }
}
